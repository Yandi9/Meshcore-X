<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:MC1.Windows.Localization"
             xmlns:vm="using:MC1.Windows.ViewModels"
             xmlns:ctl="using:MC1.Windows.Controls"
             x:Class="MC1.Windows.Views.CoreScopeLinkView"
             x:DataType="vm:CoreScopeLinkViewModel">
  <!-- Settings ▸ General ▸ CoreScope: paste the state's CoreScope link; it then gets its own tab in the sidebar. -->
  <Border Classes="group">
    <StackPanel>
      <ctl:SettingRow Title="{l:T 'Your CoreScope'}" WrapWidth="460"
                      Hint="{l:T 'Paste the link to your state\'s or region\'s CoreScope, the MeshCore network analyzer. It then gets its own CoreScope tab in the sidebar.'}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox x:Name="LinkBox" Text="{Binding LinkText}" Watermark="https://…" Width="250" KeyDown="LinkBox_OnKeyDown" />
          <Button Classes="accent" Content="{Binding LinkButtonText}" Command="{Binding LinkCommand}" />
        </StackPanel>
      </ctl:SettingRow>
      <ctl:SettingRow Title="{Binding LinkedTitle}" Hint="{Binding LinkedUrl}" IsVisible="{Binding IsLinked}" WrapWidth="460">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="{l:T 'Open'}" Command="{Binding OpenCommand}" />
          <Button Content="{l:T 'Remove'}" Command="{Binding RemoveCommand}" />
        </StackPanel>
      </ctl:SettingRow>
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,10"
                  IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <ProgressBar IsIndeterminate="True" Width="40" MinWidth="40" VerticalAlignment="Center" IsVisible="{Binding IsChecking}" />
        <TextBlock Classes="hint" Text="{Binding Status}" TextWrapping="Wrap" MaxWidth="640"
                   Classes.warning="{Binding StatusIsWarning}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
