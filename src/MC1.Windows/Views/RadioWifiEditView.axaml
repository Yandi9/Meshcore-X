<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:MC1.Windows.Localization"
             xmlns:vm="using:MC1.Windows.ViewModels"
             x:Class="MC1.Windows.Views.RadioWifiEditView"
             x:DataType="vm:RadioWifiEditViewModel">
  <!-- The radio's WiFi network name and password (applied after a reboot). -->
  <DockPanel Margin="24,20,24,18">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="{l:T 'Cancel'}" Command="{Binding CancelCommand}" IsCancel="True" />
      <Button Classes="accent" Content="{l:T 'Save'}" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" IsDefault="True" />
    </StackPanel>
    <StackPanel Spacing="6">
      <TextBlock Text="{l:T 'Network name'}" FontWeight="SemiBold" />
      <TextBox Text="{Binding Ssid}" IsEnabled="{Binding !Busy}" MaxLength="64" />
      <TextBlock Text="{l:T 'Password'}" FontWeight="SemiBold" Margin="0,8,0,0" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBox Text="{Binding Password}" PasswordChar="•" RevealPassword="{Binding ShowPassword}" IsEnabled="{Binding !Busy}" MaxLength="128" />
        <ToggleButton Grid.Column="1" Classes="icon" Margin="6,0,0,0" IsChecked="{Binding ShowPassword}" VerticalAlignment="Center"
                      ToolTip.Tip="{l:T 'Show password'}">
          <Panel>
            <PathIcon Classes="small" Data="{StaticResource Icon.Eye}" IsVisible="{Binding !ShowPassword}" />
            <PathIcon Classes="small" Data="{StaticResource Icon.EyeOff}" IsVisible="{Binding ShowPassword}" />
          </Panel>
        </ToggleButton>
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Busy}" Margin="0,6,0,0">
        <ProgressBar IsIndeterminate="True" Width="40" MinWidth="40" VerticalAlignment="Center" />
        <TextBlock Classes="caption" Text="{l:T 'Talking to the radio…'}" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Classes="hint" Text="{Binding Footer}" Margin="0,8,0,0" />
      <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </DockPanel>
</UserControl>
