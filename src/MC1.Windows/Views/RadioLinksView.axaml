<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:MC1.Windows.Localization"
             xmlns:vm="using:MC1.Windows.ViewModels"
             xmlns:conv="using:MC1.Windows.Converters"
             x:Class="MC1.Windows.Views.RadioLinksView"
             x:DataType="vm:RadioLinksViewModel">
  <!-- The radio's Bluetooth and WiFi links: the one in use, and a switch to the other. -->
  <StackPanel>
    <ItemsControl ItemsSource="{Binding Rows}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:RadioLinkItem">
          <Grid ColumnDefinitions="Auto,*,Auto" Classes="setting">
            <PathIcon Data="{Binding IconKey, Converter={x:Static conv:IconConverter.Instance}}" Foreground="{DynamicResource App.Accent}" Margin="0,0,12,0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Subtitle}" Classes="caption mono" TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="10,0,0,0">
              <Border Classes="chip" IsVisible="{Binding IsLive}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <PathIcon Classes="small" Data="{StaticResource Icon.Check}" Foreground="{DynamicResource App.Accent}" />
                  <TextBlock Text="{l:T 'In use'}" FontSize="12" />
                </StackPanel>
              </Border>
              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsSwitching}">
                <ProgressBar IsIndeterminate="True" Width="40" MinWidth="40" VerticalAlignment="Center" />
                <TextBlock Text="{l:T 'Switching…'}" VerticalAlignment="Center" />
              </StackPanel>
              <Button Content="{Binding ActionText}" IsVisible="{Binding ShowAction}" IsEnabled="{Binding CanAct}"
                      Command="{Binding $parent[UserControl].((vm:RadioLinksViewModel)DataContext).SwitchCommand}" CommandParameter="{Binding}" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Classes="hint" Text="{Binding Hint}" Margin="0,0,0,8"
               IsVisible="{Binding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </StackPanel>
</UserControl>
